# syntax=docker/dockerfile:1.7

# ============================================================
# Unified C++ Toolchain / Dev / Runtime Images
#
# Targets:
#   runtime-base
#   runtime-debug-base
#   builder-gcc
#   builder-clang
#   dev-gcc
#   dev-clang
#
# Suggested image tags:
#   cpp-runtime-base:bookworm-v1
#   cpp-runtime-debug-base:bookworm-v1
#   cpp-builder-gcc:bookworm-v1
#   cpp-builder-clang:bookworm-v1
#   cpp-dev-gcc:bookworm-v1
#   cpp-dev-clang:bookworm-v1
# ============================================================

ARG DEBIAN_VERSION=bookworm
ARG DEBIAN_FRONTEND=noninteractive
ARG UV_VERSION=0.11.10
ARG CONAN_VERSION=2.28.1
ARG PYTHON_VERSION=3.12.0
ARG GCC_VERSION=12
ARG LLVM_VERSION=14
ARG USERNAME=dev
ARG UID=1000
ARG GID=1000
ARG APP_UID=65532
ARG APP_GID=65532
ARG IMAGE_SOURCE=unknown
ARG IMAGE_REVISION=unknown
ARG IMAGE_VERSION=dev

FROM ghcr.io/astral-sh/uv:${UV_VERSION} AS uv-bin
# ============================================================
# 1. os-base
#    所有镜像共享的最小基础层
# ============================================================
FROM debian:${DEBIAN_VERSION}-slim AS os-base

ARG DEBIAN_FRONTEND
ARG IMAGE_SOURCE
ARG IMAGE_REVISION
ARG IMAGE_VERSION

ENV LANG=C.UTF-8 \
    LC_ALL=C.UTF-8

LABEL org.opencontainers.image.title="C++ toolchain images" \
      org.opencontainers.image.description="Shared C++ runtime, builder, and development images" \
      org.opencontainers.image.source="${IMAGE_SOURCE}" \
      org.opencontainers.image.revision="${IMAGE_REVISION}" \
      org.opencontainers.image.version="${IMAGE_VERSION}" \
      org.opencontainers.image.licenses="NOASSERTION"

RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
    && rm -rf \
        /var/lib/apt/lists/* \
        /usr/share/doc/* \
        /usr/share/man/* \
        /usr/share/info/* \
        /usr/share/lintian/* \
        /var/cache/debconf/*-old


# ============================================================
# 2. runtime-base
#    生产运行基础镜像
# ============================================================
FROM os-base AS runtime-base

ARG APP_HOME=/opt/app
ARG APP_UID
ARG APP_GID
ARG DEBIAN_FRONTEND

ENV APP_HOME=${APP_HOME} \
    PATH="${APP_HOME}/bin:${PATH}" \
    LD_LIBRARY_PATH="${APP_HOME}/lib"

RUN apt-get update && apt-get install -y --no-install-recommends \
        libstdc++6 \
        libgcc-s1 \
    && rm -rf \
        /var/lib/apt/lists/* \
        /usr/share/doc/* \
        /usr/share/man/* \
        /usr/share/info/* \
        /usr/share/lintian/* \
        /var/cache/debconf/*-old

RUN groupadd -g ${APP_GID} app \
    && useradd \
        --uid ${APP_UID} \
        --gid app \
        --home-dir ${APP_HOME} \
        --shell /usr/sbin/nologin \
        app \
    && mkdir -p ${APP_HOME}/bin ${APP_HOME}/lib ${APP_HOME}/etc ${APP_HOME}/log \
    && chown -R app:app ${APP_HOME}

WORKDIR ${APP_HOME}

USER app

CMD ["/bin/sh"]


# ============================================================
# 3. runtime-debug-base
#    Debug / 测试运行基础镜像
# ============================================================
FROM runtime-base AS runtime-debug-base

ARG DEBIAN_FRONTEND

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
        gdb-minimal \
        strace \
        procps \
        iproute2 \
        netcat-openbsd \
        curl \
        less \
    && rm -rf \
        /var/lib/apt/lists/* \
        /usr/share/doc/* \
        /usr/share/man/* \
        /usr/share/info/* \
        /usr/share/lintian/* \
        /var/cache/debconf/*-old

USER app

WORKDIR ${APP_HOME}

CMD ["/bin/sh"]


# ============================================================
# 4. builder-base
#    C++ 编译基础层
# ============================================================
FROM os-base AS builder-base

ARG DEBIAN_FRONTEND
ARG CONAN_VERSION
ARG PYTHON_VERSION
ARG GCC_VERSION

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    CONAN_HOME=/root/.conan2 \
    CCACHE_DIR=/root/.cache/ccache \
    UV_CACHE_DIR=/opt/uv/cache \
    UV_PYTHON_INSTALL_DIR=/opt/uv/python \
    PATH="/opt/conan/bin:${PATH}"

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        g++ \
        make \
        patch \
        libgcc-${GCC_VERSION}-dev \
        cmake \
        ninja-build \
        pkg-config \
        git \
        ccache \
    && rm -rf \
        /var/lib/apt/lists/* \
        /usr/share/doc/* \
        /usr/share/man/* \
        /usr/share/info/* \
        /usr/share/lintian/* \
        /usr/share/cmake-*/Help \
        /usr/lib/python*/test \
        /var/cache/debconf/*-old \
    && find /usr -type d -name __pycache__ -prune -exec rm -rf {} + \
    && find /usr -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete

COPY --from=uv-bin /uv /uvx /bin/

RUN mkdir -p /opt/uv/cache /opt/uv/python \
    && uv python install "${PYTHON_VERSION}" \
    && uv venv --python "${PYTHON_VERSION}" /opt/conan \
    && uv pip install --python /opt/conan/bin/python --no-cache "conan==${CONAN_VERSION}" \
    && chmod -R a+rX /opt/uv /opt/conan \
    && echo 'export PATH="/opt/conan/bin:$PATH"' > /etc/profile.d/conan.sh \
    && chmod 0644 /etc/profile.d/conan.sh \
    && ln -sf /opt/conan/bin/conan /usr/local/bin/conan \
    && conan --version \
    && find /opt/uv /opt/conan -type d -name __pycache__ -prune -exec rm -rf {} + \
    && find /opt/uv /opt/conan -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete \
    && find /opt/uv/python -type d \( -name ensurepip -o -name idlelib -o -name turtledemo \) -prune -exec rm -rf {} + \
    && find /opt/uv/python -path '*/site-packages/pip*' -prune -exec rm -rf {} + \
    && find /opt/uv/python -path '*/site-packages/setuptools*' -prune -exec rm -rf {} + \
    && find /opt/uv/python -path '*/site-packages/pkg_resources' -prune -exec rm -rf {} + \
    && find /opt/uv/python -type f -name '*.a' -delete \
    && { find /opt/uv /opt/conan -type f \( -name '*.so' -o -name '*.so.*' -o -perm /111 \) -exec strip --strip-unneeded {} + 2>/dev/null || true; } \
    && rm -rf /opt/uv/cache/*  # 清理 uv 缓存以减小镜像体积

RUN cat > /usr/local/bin/conan-detect-gnu20-profile <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

conan profile detect --force
profile="$(conan profile path default)"

if grep -q '^compiler.cppstd=' "${profile}"; then
    sed -i 's/^compiler.cppstd=.*/compiler.cppstd=gnu20/' "${profile}"
else
    sed -i '/^\[settings\]/a compiler.cppstd=gnu20' "${profile}"
fi

conan profile show -pr default
EOF

RUN chmod 0755 /usr/local/bin/conan-detect-gnu20-profile

WORKDIR /workspace

CMD ["/bin/bash"]


# ============================================================
# 5. builder-gcc
#    CI/CD GCC 编译镜像
# ============================================================
FROM builder-base AS builder-gcc

ENV CC=gcc \
    CXX=g++

RUN conan-detect-gnu20-profile

WORKDIR /workspace

CMD ["/bin/bash"]


# ============================================================
# 6. builder-clang
#    CI/CD Clang 编译镜像
# ============================================================
FROM builder-base AS builder-clang

ARG DEBIAN_FRONTEND
ARG LLVM_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
        clang-${LLVM_VERSION} \
        lld-${LLVM_VERSION} \
        libclang-rt-${LLVM_VERSION}-dev \
    && for tool in clang clang++ lld ld.lld llvm-symbolizer; do \
        if [ -e "/usr/bin/${tool}-${LLVM_VERSION}" ]; then \
            ln -sf "/usr/bin/${tool}-${LLVM_VERSION}" "/usr/local/bin/${tool}"; \
        fi; \
    done \
    && rm -rf \
        /var/lib/apt/lists/* \
        /usr/share/doc/* \
        /usr/share/man/* \
        /usr/share/info/* \
        /usr/share/lintian/* \
        /var/cache/debconf/*-old

ENV CC=clang \
    CXX=clang++

RUN conan-detect-gnu20-profile

WORKDIR /workspace

CMD ["/bin/bash"]


# ============================================================
# 7. dev-base
#    开发镜像公共基础层
# ============================================================
FROM builder-base AS dev-base

ARG DEBIAN_FRONTEND
ARG USERNAME
ARG UID
ARG GID

RUN apt-get update && apt-get install -y --no-install-recommends \
        strace \
        procps \
        iproute2 \
        iputils-ping \
        netcat-openbsd \
        curl \
        less \
        vim-tiny \
        unzip \
        tar \
        xz-utils \
        openssh-server \
        sudo \
    && rm -rf \
        /var/lib/apt/lists/* \
        /usr/share/doc/* \
        /usr/share/man/* \
        /usr/share/info/* \
        /usr/share/lintian/* \
        /var/cache/debconf/*-old

RUN groupadd -g ${GID} ${USERNAME} \
    && useradd -m -u ${UID} -g ${GID} -s /bin/bash ${USERNAME} \
    && mkdir -p /home/${USERNAME}/.conan2 \
    && mkdir -p /home/${USERNAME}/.cache/ccache \
    && mkdir -p /home/${USERNAME}/.cache/uv \
    && mkdir -p /home/${USERNAME}/.local/bin \
    && mkdir -p /home/${USERNAME}/.local/share/uv/python \
    && mkdir -p /home/${USERNAME}/.ssh \
    && mkdir -p /workspace \
    && mkdir -p /run/sshd \
    && chown -R ${USERNAME}:${USERNAME} /home/${USERNAME} /workspace \
    && chmod 700 /home/${USERNAME}/.ssh \
    && echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} \
    && chmod 0440 /etc/sudoers.d/${USERNAME}


RUN cat > /home/${USERNAME}/.dev-shellrc <<'EOF'
# ===== Custom aliases =====
alias ll='ls --color=auto -alF'
alias la='ls --color=auto -A'
alias l='ls --color=auto -CF'
alias cls='clear'
alias grep='grep --color=auto'
alias egrep='egrep --color=auto'
alias fgrep='fgrep --color=auto'

# ===== ccache helpers =====
alias ccs='ccache -s'
alias ccz='ccache -z'

# ===== CMake helpers =====
alias cb='cmake --build build'
alias ct='ctest --test-dir build --output-on-failure'
EOF

RUN cat >> /home/${USERNAME}/.bashrc <<'EOF'

if [ -f "$HOME/.dev-shellrc" ]; then
    . "$HOME/.dev-shellrc"
fi
EOF

RUN cat >> /root/.bashrc <<EOF

if [ -f "/home/${USERNAME}/.dev-shellrc" ]; then
    . "/home/${USERNAME}/.dev-shellrc"
fi
EOF

RUN cat > /home/${USERNAME}/.bash_profile <<'EOF'
if [ -f "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
fi
EOF

RUN cat > /home/${USERNAME}/.profile <<'EOF'
if [ "$BASH" ] && [ -f "$HOME/.bashrc" ]; then
    . "$HOME/.bashrc"
fi
EOF

RUN chown ${USERNAME}:${USERNAME} \
        /home/${USERNAME}/.dev-shellrc \
        /home/${USERNAME}/.bashrc \
        /home/${USERNAME}/.bash_profile \
        /home/${USERNAME}/.profile

RUN mkdir -p /etc/ssh/sshd_config.d \
    && { \
        echo 'PasswordAuthentication no'; \
        echo 'PubkeyAuthentication yes'; \
        echo 'PermitRootLogin no'; \
    } > /etc/ssh/sshd_config.d/20-dev-container.conf

ENV DEV_USERNAME=${USERNAME} \
    DEV_HOME=/home/${USERNAME} \
    CONAN_HOME=/home/${USERNAME}/.conan2 \
    CCACHE_DIR=/home/${USERNAME}/.cache/ccache \
    UV_CACHE_DIR=/home/${USERNAME}/.cache/uv \
    UV_PYTHON_INSTALL_DIR=/home/${USERNAME}/.local/share/uv/python \
    PATH="/home/${USERNAME}/.local/bin:${PATH}"

RUN cat > /usr/local/bin/dev-container-entrypoint <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

dev_user="${DEV_USERNAME:-dev}"

configure_dev_user() {
    if [[ "$(id -u)" != "0" ]]; then
        return
    fi

    if ! id "${dev_user}" >/dev/null 2>&1; then
        echo "dev-container-entrypoint: user ${dev_user} does not exist" >&2
        return
    fi

    local current_uid current_gid target_uid target_gid changed
    current_uid="$(id -u "${dev_user}")"
    current_gid="$(id -g "${dev_user}")"
    target_uid="${DEV_UID:-${current_uid}}"
    target_gid="${DEV_GID:-${current_gid}}"
    changed=0

    if [[ "${target_gid}" != "${current_gid}" ]]; then
        if getent group "${target_gid}" >/dev/null \
            && [[ "$(getent group "${target_gid}" | cut -d: -f1)" != "${dev_user}" ]]; then
            echo "dev-container-entrypoint: DEV_GID ${target_gid} already exists; keeping gid ${current_gid}" >&2
            target_gid="${current_gid}"
        else
            groupmod -g "${target_gid}" "${dev_user}"
            changed=1
        fi
    fi

    if [[ "${target_uid}" != "${current_uid}" ]]; then
        if getent passwd "${target_uid}" >/dev/null \
            && [[ "$(getent passwd "${target_uid}" | cut -d: -f1)" != "${dev_user}" ]]; then
            echo "dev-container-entrypoint: DEV_UID ${target_uid} already exists; keeping uid ${current_uid}" >&2
            target_uid="${current_uid}"
        else
            usermod -u "${target_uid}" "${dev_user}"
            changed=1
        fi
    fi

    if [[ "${changed}" == "1" ]]; then
        local dev_home dev_group
        dev_home="$(getent passwd "${dev_user}" | cut -d: -f6)"
        dev_group="$(id -gn "${dev_user}")"
        chown -R "${dev_user}:${dev_group}" "${dev_home}"
    fi
}

install_authorized_keys() {
    if [[ "$(id -u)" != "0" || -z "${DEV_AUTHORIZED_KEYS:-}" ]]; then
        return
    fi

    local dev_home dev_group
    dev_home="$(getent passwd "${dev_user}" | cut -d: -f6)"
    dev_group="$(id -gn "${dev_user}")"

    install -d -m 0700 -o "${dev_user}" -g "${dev_group}" "${dev_home}/.ssh"
    printf '%s\n' "${DEV_AUTHORIZED_KEYS}" > "${dev_home}/.ssh/authorized_keys"
    chown "${dev_user}:${dev_group}" "${dev_home}/.ssh/authorized_keys"
    chmod 0600 "${dev_home}/.ssh/authorized_keys"
}

prepare_sshd() {
    if [[ "$(id -u)" == "0" ]]; then
        mkdir -p /run/sshd
        ssh-keygen -A >/dev/null
    fi
}

configure_dev_user
install_authorized_keys

if [[ $# -eq 0 ]]; then
    set -- /usr/sbin/sshd -D -e
fi

if [[ "${1}" == "sshd" || "${1}" == "/usr/sbin/sshd" ]]; then
    prepare_sshd
    exec /usr/sbin/sshd "${@:2}"
fi

if [[ "$(id -u)" == "0" ]]; then
    exec sudo -E -H -u "${dev_user}" -- "$@"
fi

exec "$@"
EOF

RUN chmod 0755 /usr/local/bin/dev-container-entrypoint

WORKDIR /workspace

EXPOSE 22

ENTRYPOINT ["/usr/local/bin/dev-container-entrypoint"]

CMD ["/usr/sbin/sshd", "-D", "-e"]


# ============================================================
# 8. dev-gcc
#    GCC 开发镜像
# ============================================================
FROM dev-base AS dev-gcc

ARG DEBIAN_FRONTEND
ARG USERNAME

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
        gdb-minimal \
    && rm -rf \
        /var/lib/apt/lists/* \
        /usr/share/doc/* \
        /usr/share/man/* \
        /usr/share/info/* \
        /usr/share/lintian/* \
        /var/cache/debconf/*-old

USER ${USERNAME}

ENV CC=/usr/bin/gcc \
    CXX=/usr/bin/g++

# 在设置了环境变量后，生成普通用户的 GCC Conan Profile
RUN conan-detect-gnu20-profile \
    && echo 'export CC=/usr/bin/gcc' >> /home/${USERNAME}/.bashrc \
    && echo 'export CXX=/usr/bin/g++' >> /home/${USERNAME}/.bashrc

USER root
RUN printf '%s\n' \
        "SetEnv CC=/usr/bin/gcc CXX=/usr/bin/g++ CONAN_HOME=/home/${USERNAME}/.conan2 CCACHE_DIR=/home/${USERNAME}/.cache/ccache UV_CACHE_DIR=/home/${USERNAME}/.cache/uv UV_PYTHON_INSTALL_DIR=/home/${USERNAME}/.local/share/uv/python" \
        > /etc/ssh/sshd_config.d/30-toolchain-env.conf

WORKDIR /workspace
CMD ["/usr/sbin/sshd", "-D", "-e"]


# ============================================================
# 9. dev-clang
#    Clang / LLVM 开发镜像
# ============================================================
FROM dev-base AS dev-clang

ARG DEBIAN_FRONTEND
ARG USERNAME
ARG LLVM_VERSION

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
        clang-${LLVM_VERSION} \
        clangd-${LLVM_VERSION} \
        clang-format-${LLVM_VERSION} \
        clang-tidy-${LLVM_VERSION} \
        lld-${LLVM_VERSION} \
        libclang-rt-${LLVM_VERSION}-dev \
        gdb-minimal \
    && for tool in clang clang++ clangd clang-format clang-tidy lld ld.lld llvm-symbolizer; do \
        if [ -e "/usr/bin/${tool}-${LLVM_VERSION}" ]; then \
            ln -sf "/usr/bin/${tool}-${LLVM_VERSION}" "/usr/local/bin/${tool}"; \
        fi; \
    done \
    && rm -rf \
        /var/lib/apt/lists/* \
        /usr/share/doc/* \
        /usr/share/man/* \
        /usr/share/info/* \
        /usr/share/lintian/* \
        /usr/lib/python*/test \
        /var/cache/debconf/*-old \
    && find /usr -type d -name __pycache__ -prune -exec rm -rf {} + \
    && find /usr -type f \( -name '*.pyc' -o -name '*.pyo' \) -delete

USER ${USERNAME}

ENV CC=clang \
    CXX=clang++

# 关键修复：此时环境变量 CC=clang 已经生效，Conan 会正确识别出 Clang 并生成对应的 Profile
RUN conan-detect-gnu20-profile \
    && echo 'export CC=clang' >> /home/${USERNAME}/.bashrc \
    && echo 'export CXX=clang++' >> /home/${USERNAME}/.bashrc

USER root
RUN printf '%s\n' \
        "SetEnv CC=clang CXX=clang++ CONAN_HOME=/home/${USERNAME}/.conan2 CCACHE_DIR=/home/${USERNAME}/.cache/ccache UV_CACHE_DIR=/home/${USERNAME}/.cache/uv UV_PYTHON_INSTALL_DIR=/home/${USERNAME}/.local/share/uv/python" \
        > /etc/ssh/sshd_config.d/30-toolchain-env.conf

WORKDIR /workspace
CMD ["/usr/sbin/sshd", "-D", "-e"]
